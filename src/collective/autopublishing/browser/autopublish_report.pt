<html xmlns="http://www.w3.org/1999/xhtml"
      lang="en"
      metal:use-macro="here/main_template/macros/master"
      xml:lang="en"
      i18n:domain="collective.autopublishing"
>

  <head>
    <metal:block fill-slot="top_slot"
                 tal:define="
                   dummy python:request.set('disable_border',1);
                   disable_column_one python:request.set('disable_plone.leftcolumn',1);
                   disable_column_two python:request.set('disable_plone.rightcolumn',1);
                 "
    />
  </head>
  <body>

    <metal:main fill-slot="main">

      <h1 class="documentFirstHeading"
          i18n:translate=""
      >Autopublishing: Report of next actions taken</h1>

      <h2 i18n:translate="">Publish actions</h2>
      <div tal:repeat="record view/report/p_result">
        <h3 tal:content="record/header"></h3>
        <label i18n:translate="">Content types:</label>
        <span tal:content="record/content_types"></span><br />
        <label i18n:translate="">Initial state:</label>
        <span tal:content="record/initial_state"></span><br />
        <label i18n:translate="">Transition:</label>
        <span tal:content="record/transition"></span><br />
        <label i18n:translate="">Date index/method:</label>
        <span tal:content="record/date_index_method | nothing"></span><br />
        <label i18n:translate="">Actions:</label><br />
        <table class="listing"
               border="1"
        >
          <tr>
            <th i18n:translate="">Transition</th>
            <th i18n:translate="">Portal type</th>
            <th i18n:translate="">Title</th>
            <th i18n:translate="">Url</th>
          </tr>
          <tr tal:repeat="action record/actions">
            <td tal:content="action/transition"></td>
            <td tal:content="action/portal_type"></td>
            <td tal:content="action/title"></td>
            <td><a tal:content="action/url"
                 tal:attributes="
                   href action/url;
                 "
              ></a></td>
          </tr>
        </table>
      </div>

      <hr />

      <h2 i18n:translate="">Retract actions</h2>
      <div tal:repeat="record view/report/r_result">
        <h3 tal:content="record/header"></h3>
        <label i18n:translate="">Content types:</label>
        <span tal:content="record/content_types"></span><br />
        <label i18n:translate="">Initial state:</label>
        <span tal:content="record/initial_state"></span><br />
        <label i18n:translate="">Transition:</label>
        <span tal:content="record/transition"></span><br />
        <label i18n:translate="">Date index/method:</label>
        <span tal:content="record/date_index_method | nothing"></span><br />
        <label i18n:translate="">Actions:</label><br />
        <table class="listing"
               border="1"
        >
          <tr>
            <th i18n:translate="">Transition</th>
            <th i18n:translate="">Portal type</th>
            <th i18n:translate="">Title</th>
            <th i18n:translate="">Url</th>
          </tr>
          <tr tal:repeat="action record/actions">
            <td tal:content="action/transition"></td>
            <td tal:content="action/portal_type"></td>
            <td tal:content="action/title"></td>
            <td><a tal:content="action/url"
                 tal:attributes="
                   href action/url;
                 "
              ></a></td>
          </tr>
        </table>
      </div>

    </metal:main>

  </body>
</html>

